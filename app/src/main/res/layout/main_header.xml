<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="28dp">

    <!-- Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@null"
            android:src="@mipmap/ic_launcher" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/text"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tagline"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/open_settings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/settings"
            android:src="@drawable/ic_tune" />
    </LinearLayout>

    <!-- Accessibility service off -->
    <LinearLayout
        android:id="@+id/access_card"
        style="@style/Card"
        android:layout_marginTop="20dp"
        android:padding="20dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/access_dot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:contentDescription="@null"
                android:src="@drawable/dot" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/access_title"
                android:textColor="@color/text"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            style="@style/RowSummary"
            android:layout_marginTop="6dp"
            android:text="@string/access_text" />

        <Button
            android:id="@+id/open_access"
            style="@style/AccentButton"
            android:layout_marginTop="16dp"
            android:text="@string/open_access" />
    </LinearLayout>

    <!-- Memory dashboard -->
    <LinearLayout
        style="@style/Card"
        android:layout_marginTop="20dp"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.unl0cker.hibernate.MemoryRing
                android:id="@+id/ring"
                android:layout_width="128dp"
                android:layout_height="128dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="22dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Caption"
                    android:text="@string/memory" />

                <TextView
                    android:id="@+id/mem_used"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/text"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/mem_total"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/mem_free"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/mem_free"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="18dp"
            android:background="@color/divider" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/stat_awake"
                style="@style/Stat">

                <TextView
                    android:id="@+id/stat_awake_n"
                    style="@style/StatNumber" />

                <TextView
                    style="@style/StatLabel"
                    android:text="@string/tab_awake" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/stat_asleep"
                style="@style/Stat">

                <TextView
                    android:id="@+id/stat_asleep_n"
                    style="@style/StatNumber" />

                <TextView
                    style="@style/StatLabel"
                    android:text="@string/tab_asleep" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/stat_failed"
                style="@style/Stat">

                <TextView
                    android:id="@+id/stat_failed_n"
                    style="@style/StatNumber" />

                <TextView
                    style="@style/StatLabel"
                    android:text="@string/tab_failed" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Hibernate -->
    <FrameLayout
        android:id="@+id/hibernate"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/button_accent"
        android:clickable="true"
        android:focusable="true">

        <ProgressBar
            android:id="@+id/hib_progress"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:progressDrawable="@drawable/button_progress"
            android:visibility="invisible" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_moon"
                android:tint="@color/on_button" />

            <TextView
                android:id="@+id/hib_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/on_button"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/mode_line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="?android:attr/selectableItemBackground"
        android:gravity="center"
        android:padding="6dp"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/result_line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:textColor="@color/accent_text"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Tabs -->
    <com.unl0cker.hibernate.SegmentedTabs
        android:id="@+id/tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp" />

    <TextView
        android:id="@+id/tab_hint"
        style="@style/RowSummary"
        android:layout_width="match_parent"
        android:layout_marginStart="8dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="8dp"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/failed_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <Button
            android:id="@+id/retry_all"
            style="@style/OutlineButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/retry_all" />

        <Button
            android:id="@+id/clear_failed"
            style="@style/OutlineButton"
            android:layout_width="0dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="@string/clear_failed" />
    </LinearLayout>
</LinearLayout>
