<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="24dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <include layout="@layout/title_bar" />

        <TextView
            style="@style/SectionLabel"
            android:text="@string/section_apps" />

        <LinearLayout style="@style/Card">

            <LinearLayout
                android:id="@+id/row_user_apps"
                style="@style/SettingRow">

                <LinearLayout style="@style/SettingText">

                    <TextView
                        style="@style/RowTitle"
                        android:text="@string/set_user_apps" />

                    <TextView
                        style="@style/RowSummary"
                        android:text="@string/set_user_apps_summary" />
                </LinearLayout>

                <Switch
                    android:id="@+id/switch_user_apps"
                    style="@style/Toggle" />
            </LinearLayout>

            <View style="@style/Divider" />

            <LinearLayout
                android:id="@+id/row_system_apps"
                style="@style/SettingRow">

                <LinearLayout style="@style/SettingText">

                    <TextView
                        style="@style/RowTitle"
                        android:text="@string/set_system_apps" />

                    <TextView
                        style="@style/RowSummary"
                        android:text="@string/set_system_apps_summary" />
                </LinearLayout>

                <Switch
                    android:id="@+id/switch_system_apps"
                    style="@style/Toggle" />
            </LinearLayout>

            <View style="@style/Divider" />

            <LinearLayout
                android:id="@+id/row_only_list"
                style="@style/SettingRow">

                <LinearLayout style="@style/SettingText">

                    <TextView
                        style="@style/RowTitle"
                        android:text="@string/set_only_list" />

                    <TextView
                        style="@style/RowSummary"
                        android:text="@string/set_only_list_summary" />
                </LinearLayout>

                <Switch
                    android:id="@+id/switch_only_list"
                    style="@style/Toggle" />
            </LinearLayout>

            <View style="@style/Divider" />

            <LinearLayout
                android:id="@+id/row_list"
                style="@style/SettingRow">

                <LinearLayout style="@style/SettingText">

                    <TextView
                        style="@style/RowTitle"
                        android:text="@string/set_list" />

                    <TextView
                        android:id="@+id/summary_list"
                        style="@style/RowSummary" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="@string/chevron"
                    android:textColor="@color/text_secondary"
                    android:textSize="24sp" />
            </LinearLayout>

            <View style="@style/Divider" />

            <LinearLayout
                android:id="@+id/row_exceptions"
                style="@style/SettingRow">

                <LinearLayout style="@style/SettingText">

                    <TextView
                        style="@style/RowTitle"
                        android:text="@string/set_exceptions" />

                    <TextView
                        android:id="@+id/summary_exceptions"
                        style="@style/RowSummary" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="@string/chevron"
                    android:textColor="@color/text_secondary"
                    android:textSize="24sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/RowSummary"
            android:layout_marginStart="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="20dp"
            android:text="@string/set_protected"
            android:textSize="13sp" />

        <TextView
            style="@style/SectionLabel"
            android:text="@string/section_automation" />

        <LinearLayout style="@style/Card">

            <LinearLayout
                android:id="@+id/row_screen_off"
                style="@style/SettingRow">

                <LinearLayout style="@style/SettingText">

                    <TextView
                        style="@style/RowTitle"
                        android:text="@string/set_screen_off" />

                    <TextView
                        style="@style/RowSummary"
                        android:text="@string/set_screen_off_summary" />
                </LinearLayout>

                <Switch
                    android:id="@+id/switch_screen_off"
                    style="@style/Toggle" />
            </LinearLayout>

            <View style="@style/Divider" />

            <LinearLayout
                android:id="@+id/row_screen_off_delay"
                style="@style/SliderRow">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/RowTitle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/set_screen_off_delay" />

                    <TextView
                        android:id="@+id/value_screen_off_delay"
                        style="@style/SliderValue" />
                </LinearLayout>

                <TextView
                    style="@style/RowSummary"
                    android:text="@string/set_screen_off_delay_summary" />

                <SeekBar
                    android:id="@+id/slider_screen_off_delay"
                    style="@style/Slider" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/SectionLabel"
            android:text="@string/section_fast" />

        <LinearLayout style="@style/Card">

            <LinearLayout
                android:id="@+id/row_fast"
                style="@style/SettingRow">

                <LinearLayout style="@style/SettingText">

                    <TextView
                        style="@style/RowTitle"
                        android:text="@string/set_fast" />

                    <TextView
                        style="@style/RowSummary"
                        android:text="@string/set_fast_summary" />
                </LinearLayout>

                <Switch
                    android:id="@+id/switch_fast"
                    style="@style/Toggle" />
            </LinearLayout>

            <View style="@style/Divider" />

            <LinearLayout
                android:id="@+id/row_setup"
                style="@style/SettingRow">

                <LinearLayout style="@style/SettingText">

                    <TextView
                        style="@style/RowTitle"
                        android:text="@string/set_setup" />

                    <TextView
                        android:id="@+id/summary_setup"
                        style="@style/RowSummary" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="@string/chevron"
                    android:textColor="@color/text_secondary"
                    android:textSize="24sp" />
            </LinearLayout>

            <View style="@style/Divider" />

            <LinearLayout
                android:id="@+id/row_wifi_off"
                style="@style/SettingRow">

                <LinearLayout style="@style/SettingText">

                    <TextView
                        style="@style/RowTitle"
                        android:text="@string/set_wifi_off" />

                    <TextView
                        style="@style/RowSummary"
                        android:text="@string/set_wifi_off_summary" />
                </LinearLayout>

                <Switch
                    android:id="@+id/switch_wifi_off"
                    style="@style/Toggle" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/SectionLabel"
            android:text="@string/section_click" />

        <LinearLayout style="@style/Card">

            <LinearLayout
                android:id="@+id/row_overlay"
                style="@style/SettingRow">

                <LinearLayout style="@style/SettingText">

                    <TextView
                        style="@style/RowTitle"
                        android:text="@string/set_overlay" />

                    <TextView
                        style="@style/RowSummary"
                        android:text="@string/set_overlay_summary" />
                </LinearLayout>

                <Switch
                    android:id="@+id/switch_overlay"
                    style="@style/Toggle" />
            </LinearLayout>

            <View style="@style/Divider" />

            <LinearLayout
                android:id="@+id/row_action_delay"
                style="@style/SliderRow">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/RowTitle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/set_action_delay" />

                    <TextView
                        android:id="@+id/value_action_delay"
                        style="@style/SliderValue" />
                </LinearLayout>

                <TextView
                    style="@style/RowSummary"
                    android:text="@string/set_action_delay_summary" />

                <SeekBar
                    android:id="@+id/slider_action_delay"
                    style="@style/Slider" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/SectionLabel"
            android:text="@string/section_backup" />

        <LinearLayout style="@style/Card">

            <LinearLayout
                android:id="@+id/row_export"
                style="@style/SettingRow">

                <LinearLayout style="@style/SettingText">

                    <TextView
                        style="@style/RowTitle"
                        android:text="@string/set_export" />

                    <TextView
                        style="@style/RowSummary"
                        android:text="@string/set_export_summary" />
                </LinearLayout>
            </LinearLayout>

            <View style="@style/Divider" />

            <LinearLayout
                android:id="@+id/row_import"
                style="@style/SettingRow">

                <LinearLayout style="@style/SettingText">

                    <TextView
                        style="@style/RowTitle"
                        android:text="@string/set_import" />

                    <TextView
                        style="@style/RowSummary"
                        android:text="@string/set_import_summary" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
